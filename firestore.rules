rules_version = '2';

// Each signed-in player can read, write and delete only their own record.
service cloud.firestore {
  match /databases/{database}/documents {
    match /players/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['schema', 'settings', 'daily', 'unlimited', 'games', 'updatedAt']);
    }
  }
}
